Algoritmo Comisiones
	Definir v1, v2, v3, c1, c2, c3, total Como Real;
	Leer v1, v2, v3;
	c1 <- v1*0.05;
	c2 <- v2*0.035;
	c3 <- v3*0.02;
	total <- c1+c2+c3;
	Escribir 'Comisión 1: ', c1;
	Escribir 'Comisión 2: ', c2;
	Escribir 'Comisión 3: ', c3;
	Escribir 'Total comisión: ', total;
FinAlgoritmo
