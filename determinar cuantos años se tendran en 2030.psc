Función edad <- CalcularEdad(anioNacimiento)
	edad <- 2030-anioNacimiento
FinFunción

Algoritmo EdadEn2030
	Definir anioNacimiento, edad Como Entero
	Escribir 'Ingrese su año de nacimiento:'
	Leer anioNacimiento
	edad <- CalcularEdad(anioNacimiento)
	Escribir 'En el año 2030 tendrá ', edad, ' años.'
FinAlgoritmo
