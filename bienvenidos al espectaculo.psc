Proceso sin_titulo
	Definir edad Como Entero;
	Escribir "Bienvenidos al Espectáculo";
	Escribir "";
	Escribir "Ingrese su edad, en años cumplidos";
	Leer edad;
	Si edad < 11 Entonces
		Escribir "Gracias Puede ingresar sin costo";
	SiNo
		Escribir "Gracias, el ingreso tiene un valor de 1000 COP ";
	FinSi
		
FinProceso
