Proceso sin_titulo
	Definir numLados Como Entero;
	Escribir 'Indique el número de lados del polígono desde tres lados en adelante';
	Leer numLados;
	Segun numLados  Hacer
		3:
			Escribir 'Un Polígono de tres (3) lados se denomina Triángulo';
		4:
			Escribir 'Un Polígono de cuatro (4) lados se denomina Cuadrado';
		5:
			Escribir 'Un Políono de cinco (5) lados se denomina Pentágono';
		De Otro Modo:
			Escribir 'El Polígono no existe o no está incluido en el programa';
	FinSegun
FinProceso
