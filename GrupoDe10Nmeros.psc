Algoritmo GrupoDe10Nmeros
	Definir n1,n2,n3,n4,n5,n6,n7,n8,n9,n10 Como Real;
    Definir suma, promedio Como Real;
	
    Escribir "Ingrese 10 números:";
	
    Leer n1;
    Leer n2;
    Leer n3;
    Leer n4;
    Leer n5;
    Leer n6;
    Leer n7;
    Leer n8;
    Leer n9;
    Leer n10;
	
    suma <- n1+n2+n3+n4+n5+n6+n7+n8+n9+n10;
    promedio <- suma / 10;
	
    Escribir "La suma es: ", suma;
    Escribir "El promedio es: ", promedio;
FinAlgoritmo
